# Azure Infrastructure Configuration Template
# Copy this file to .env.azure and fill in your values
# DO NOT COMMIT .env.azure TO GIT!

# ============================================
# Azure Authentication
# ============================================
# Get these values from your Azure subscription
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_TENANT_ID=your-tenant-id-here

# Service Principal Credentials (for programmatic access)
# Created by setup-infrastructure.sh or manually via Azure Portal
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# ============================================
# Azure Resources
# ============================================
# Resource group containing all Dev8 resources
AZURE_RESOURCE_GROUP=dev8-mvp-rg

# Storage account name (globally unique, lowercase, no hyphens)
# Format: dev8mvpstorage{random}
AZURE_STORAGE_ACCOUNT=dev8mvpstorage12345678

# Container registry name (globally unique, alphanumeric only)
# Format: dev8mvpregistry{random}
AZURE_CONTAINER_REGISTRY=dev8mvpregistry12345678

# Azure region for all resources
AZURE_REGION=eastus

# ============================================
# Storage Configuration
# ============================================
# Storage connection string (contains account key)
# Format: DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=xxx;AccountKey=xxx;EndpointSuffix=core.windows.net

# Storage account primary access key
AZURE_STORAGE_KEY=your-storage-key-here

# ============================================
# Container Registry Configuration
# ============================================
# Registry login server URL
# Format: {registryname}.azurecr.io
AZURE_REGISTRY_LOGIN_SERVER=dev8mvpregistry12345678.azurecr.io

# Registry admin credentials (for docker login)
AZURE_REGISTRY_USERNAME=dev8mvpregistry12345678
AZURE_REGISTRY_PASSWORD=your-registry-password-here

# ============================================
# Optional: Cost Management
# ============================================
# Budget name for cost tracking
AZURE_BUDGET_NAME=dev8-mvp-budget

# Monthly budget amount in USD
AZURE_BUDGET_AMOUNT=50
