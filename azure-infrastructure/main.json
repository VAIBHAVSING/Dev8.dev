              "properties": {
                "timePeriod": {
                  "startDate": "[parameters('startDate')]",
                  "endDate": "[parameters('endDate')]"
                },
                "timeGrain": "Monthly",
                "amount": "[parameters('budgetAmount')]",
                "category": "Cost",
                "notifications": {
                  "Alert50": {
                    "enabled": true,
                    "operator": "GreaterThan",
                    "threshold": "[parameters('alertThresholds')[0]]",
                    "contactEmails": "[parameters('contactEmails')]",
                    "contactRoles": [
                      "Owner",
                      "Contributor"
                    ],
                    "thresholdType": "Actual"
                  },
                  "Alert75": {
                    "enabled": true,
                    "operator": "GreaterThan",
                    "threshold": "[parameters('alertThresholds')[1]]",
                    "contactEmails": "[parameters('contactEmails')]",
                    "contactRoles": [
                      "Owner",
                      "Contributor"
                    ],
                    "thresholdType": "Actual"
                  },
                  "Alert90": {
                    "enabled": true,
                    "operator": "GreaterThan",
                    "threshold": "[parameters('alertThresholds')[2]]",
                    "contactEmails": "[parameters('contactEmails')]",
                    "contactRoles": [
                      "Owner",
                      "Contributor"
                    ],
                    "thresholdType": "Actual"
