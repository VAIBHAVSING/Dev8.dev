# Dev8.dev Docker Environment Configuration
# Copy this file to .env and fill in your credentials

# GitHub Authentication (Required for Copilot)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:org, copilot (if using Copilot)
GITHUB_TOKEN=ghp_your_github_token_here
# or
GH_TOKEN=ghp_your_github_token_here

# Git Configuration (Optional but recommended)
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=your.email@example.com

# SSH Keys (Optional)
# Public key for SSH authentication
SSH_PUBLIC_KEY=ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQC...

# Private key for Git operations (if needed)
# SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----

# Code Server Configuration (Optional)
CODE_SERVER_PASSWORD=dev8dev
CODE_SERVER_AUTH=password  # Options: password, none

# AI Tools API Keys (Optional)
# Claude AI (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (GPT-4, Codex)
OPENAI_API_KEY=sk-your-key-here

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
# or
GEMINI_API_KEY=your-gemini-api-key

# Supervisor Configuration (Optional)
SUPERVISOR_ENABLED=true
BACKUP_ENABLED=true
SUPERVISOR_MONITOR_INTERVAL=30s
SUPERVISOR_BACKUP_INTERVAL=300s
SUPERVISOR_BACKUP_MOUNT_PATH=/mnt/azure-volume
SUPERVISOR_HTTP_ENABLED=true
SUPERVISOR_HTTP_ADDR=127.0.0.1:9000

# Azure Storage for Persistent Volumes (Optional)
AZURE_BLOB_ACCOUNT_NAME=your-storage-account
AZURE_BLOB_ACCOUNT_KEY=your-storage-key
AZURE_BLOB_CONTAINER=dev8-workspaces
AZURE_BLOB_SAS_TOKEN=your-sas-token
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_CONTAINER=dev8-backups

# AWS S3 for Backups (Optional)
AWS_S3_BUCKET=dev8-backups
AWS_S3_PREFIX=workspaces
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Docker Registry (Optional, for pushing images)
DOCKER_REGISTRY=dev8registry.azurecr.io

# Build Configuration (Optional)
VERSION=latest
BUILD_BASE=true
BUILD_MVP=true
